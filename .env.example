# ---------------------------------------------------------------------------
# resume_build_ai environment. Copy to .env.local and fill in real values.
# NEVER commit .env.local. Variables prefixed NEXT_PUBLIC_ are sent to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API). Public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key (Project Settings -> API). Public; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role key. SERVER ONLY. Bypasses RLS; used for account creation, grading.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:migrate` / `db:seed` and RLS tests.
# Project Settings -> Database -> Connection string (URI). Use the session pooler on IPv4 networks.
SUPABASE_DB_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Random string, >= 32 chars. Signs proctor sessions and PIN-lockout device ids.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Anthropic API key (Phase 2 AI features). SERVER ONLY.
ANTHROPIC_API_KEY=
# Model used for AI features. Cheap default; override if needed.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Where the browser loads the Pyodide runtime (Python tests). Must end with a slash.
NEXT_PUBLIC_PYODIDE_BASE_URL=https://cdn.jsdelivr.net/pyodide/v0.26.4/full/
# Where the browser loads sql.js (SQL tests). Must end with a slash.
NEXT_PUBLIC_SQLJS_BASE_URL=https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.3/

# Public base URL of the deployed app (used in QR codes / absolute links). Optional locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
